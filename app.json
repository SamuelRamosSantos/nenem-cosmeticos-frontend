      },
      "package": "com.anonymous.frontend"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a74de704-50d1-4a0a-8347-846eb832141b"
      }
    },
    "owner": "samuel_utfpr",
    "plugins": [
      "expo-sharing",
      "expo-secure-store"
    ]
  }
